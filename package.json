{
  "name": "dsh-mediaplayer-plugin",
  "version": "0.1.0",
  "description": "DSH の右 Sidebar で workspace の音声・動画を再生するプレイヤー",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node tests/check-independence.mjs && bash tests/check-glyphs.sh",
    "fixtures": "bash tests/make-fixtures.sh",
    "install-web": "bash scripts/install-web.sh"
  },
  "license": "Apache-2.0",
  "private": true
}
